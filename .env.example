# Development settings. Copy to .env; never commit real credentials.
DJANGO_DEBUG=true
# Generate your own key using the command in README.md.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Production HTTPS only: review HSTS before increasing this value.
DJANGO_SECURE_HSTS_SECONDS=0
# Production SMTP configuration (the app currently has no email-based user flow).
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true

# Leave blank until you configure Gemini. AI actions show an error without a key.
GEMINI_API_KEY=
# Existing code default; verify model availability for your Gemini account.
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MIN_CONFIDENCE=0.60
QUIZ_DEFAULT_QUESTION_COUNT=5
QUIZ_MAX_QUESTION_COUNT=20
QUIZ_MAX_CONTEXT_CHARS=12000
